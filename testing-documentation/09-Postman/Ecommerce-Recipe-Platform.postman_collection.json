        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Preview omits premium contents', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.equal(pm.variables.get('recipeId'));",
              "    pm.expect(body.premium).to.be.true;",
              "    pm.expect(body.fullAccess).to.be.false;",
              "    pm.expect(body.ingredients == null).to.be.true;",
              "    pm.expect(body.steps == null).to.be.true;",
              "});"
            ]
          }
        }
      ]
