    {
      "name": "API-11 Unpaid premium content stays hidden",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/recipes/{{recipeId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
