{
  "info": {
    "name": "Ecommerce Recipe Platform - Software Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18081"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const url = pm.variables.get('baseUrl');",
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+$/.test(url)) {",
          "    pm.execution.skipRequest();",
          "    throw new Error('Use an isolated loopback backend');",
          "}",
          "if (pm.info.requestName.startsWith('API-01')) {",
          "    const id = pm.variables.replaceIn('{{$guid}}');",
          "    pm.collectionVariables.set('runId', id);",
          "    for (const role of ['buyer', 'chef']) {",
          "        pm.collectionVariables.set(role + 'Email', role + '-' + id + '@example.test');",
          "        pm.collectionVariables.set(role + 'Password', pm.variables.replaceIn('{{$guid}}'));",
          "        pm.collectionVariables.unset(role + 'Token');",
          "    }",
          "    pm.collectionVariables.unset('recipeId');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "API-01 Register buyer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register/buyer",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Validation Buyer\", \"email\": \"{{buyerEmail}}\", \"password\": \"{{buyerPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Authenticated BUYER identity', () => {",
              "    pm.expect(body.token).to.be.a('string').and.not.empty;",
              "    pm.expect(body.user.id).to.be.a('string').and.not.empty;",
              "    pm.expect(body.user.email).to.equal(pm.variables.get('buyerEmail'));",
              "    pm.expect(body.user.role).to.equal('BUYER');",
              "    pm.expect(body.user).not.to.have.property('password');",
              "});",
              "pm.collectionVariables.set('buyerToken', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 Register chef",
      "request": {
